# Backend API Settings
PORT=8000
SECRET_KEY=super_secret_jwt_key_notebooklm_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie Settings
# For local HTTP dev: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# For production (cross-origin HTTPS): omit these to use defaults (secure=true, samesite=none)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Database & Cache
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=docs_lm
REDIS_URL=redis://localhost:6379/0

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=docs-lm-index

# Local Ollama Provider (Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Gemini / OpenAI (Commented out)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=docs-lm

# Storage Provider (local | cloudinary | s3)
STORAGE_PROVIDER=local
